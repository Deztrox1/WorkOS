# Shared by both WorkOS server blocks (installed as /etc/nginx/snippets/workos-app.conf).
root /var/www/workos;
index index.html;

include snippets/workos-headers.conf;

gzip on;
gzip_types text/css application/javascript application/json image/svg+xml;

# A crawler blocked here never reads the noindex header, so a linked URL could still be listed. Let it in; noindex keeps it out.
location = /robots.txt { default_type text/plain; return 200 "User-agent: *\nAllow: /\n"; }

# The service worker must always be revalidated or updates never reach the phone.
location = /sw.js {
    add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    include snippets/workos-headers.conf;
    add_header Service-Worker-Allowed "/" always;
    try_files $uri =404;
}

# The theme bootstrap is a fixed name (no hash), so it must revalidate too.
location = /theme.js {
    add_header Cache-Control "no-cache" always;
    include snippets/workos-headers.conf;
    try_files $uri =404;
}

# Vite output is content-hashed: cache for a year.
location /assets/ {
    # No `always`: a 404 for a missing hashed file must not be cached for a year (QA r1 I06).
    add_header Cache-Control "public, max-age=31536000, immutable";
    include snippets/workos-headers.conf;
    try_files $uri =404;
}

# The manifest has its own type (it was served as octet-stream) and revalidates (QA r1 I12).
location = /manifest.webmanifest {
    default_type application/manifest+json;
    add_header Cache-Control "no-cache" always;
    include snippets/workos-headers.conf;
    try_files $uri =404;
}

# index.html changes per deploy.
location = /index.html {
    add_header Cache-Control "no-cache" always;
    include snippets/workos-headers.conf;
}

# Dotfiles (/.env, /.git/...) never exist in the web root; without this the SPA fallback answered 200 with
# index.html, which looks like a leak to scanners (QA r1 Q19). /.well-known stays reachable.
location ~ /\.(?!well-known(/|$)) {
    return 404;
}

# Single page app: hash routes need only index.html, any other path falls back to it.
location / {
    try_files $uri $uri/ /index.html;
}
