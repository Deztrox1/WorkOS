      "name": "Theme Capsule",
      "kind": "custom",
      "description": "64 by 32 capsule, chip glides.",
      "html": "<span class=\"ds-cap\"><span class=\"ds-chip\"></span></span>",
      "css": ".ds-cap{position:relative;display:inline-block;width:64px;height:32px;border-radius:16px;border:1px solid var(--line);background:var(--paper2)}.ds-chip{position:absolute;top:3px;left:3px;width:24px;height:24px;border-radius:12px;background:var(--fg);transition:transform .4s cubic-bezier(.22,1,.36,1)}.ds-cap:hover .ds-chip{transform:translateX(32px)}"
