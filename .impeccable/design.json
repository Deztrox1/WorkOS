  "narrative": {
    "northStar": "The Handover Sheet",
    "overview": "The owner opens the app the way a day nurse takes a ward from the night shift: one ruled sheet that says what to do first and what comes after. A time spine runs down the left in mono, a priority band sits in a fixed column beside it, and ruled rows follow in order. A drawn stamp names the sheet (Morning, Day, Evening).",
    "keyCharacteristics": [
      "One ruled sheet per screen, capped at 760 px on a laptop, full bleed on a 390 px phone.",
      "Time and numbers are always JetBrains Mono. Titles are Hanken Grotesk. Bricolage is only for the date, the stamp and the evening heading.",
      "State is carried by line form as well as colour.",
      "Light and dark are equal citizens, switched by a capsule toggle."
    ],
    "rules": [
      {
        "name": "The Three-Words Rule",
        "body": "Red, amber and green mean NOW, TODAY and PLAN and nothing else.",
        "section": "colors"
      },
      {
        "name": "The One Ink Rule",
        "body": "Teal is the only accent.",
        "section": "colors"
      },
      {
        "name": "The Night Key Rule",
        "body": "At night the primary button is a dark teal key with a teal outline and teal ink.",
        "section": "colors"
      },
      {
        "name": "The Mono Numbers Rule",
        "body": "Any time, date, count, price or duration is JetBrains Mono.",
        "section": "typography"
      },
      {
        "name": "The Fixed Size Rule",
        "body": "Row text does not change size to show importance.",
        "section": "typography"
      },
      {
        "name": "The Rule Not Shadow Rule",
        "body": "Structure is drawn with 1 px lines; a shadow is only for something that floats above the sheet.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do put the answer first: the first row on Today is the owner's first pick, and the greeting names it.",
      "Do rank by band, weight and case on one text size.",
      "Do keep every target at 44 px and every time, count or amount in mono.",
      "Do use line form (dashed, half-tone, strike) as well as colour for state.",
      "Do write in plain third-grade words. Copy rules: no em dashes, no exclamation marks, no guilt words, no developer words.",
      "Do build both themes together and keep the toggle on every screen."
    ],
    "donts": [
      "Don't stack equal cards on a grey page or open with a KPI header.",
      "Don't use red, amber or green for anything but NOW, TODAY, PLAN and their status meanings.",
      "Don't add a second accent hue or a gradient.",
      "Don't put a shadow on something that sits on the sheet.",
      "Don't nag: no escalating colours, no auto-dropping, no streak shame.",
      "Don't return to the old cobalt-on-grey system; it was rejected as generic."
    ]
  }
