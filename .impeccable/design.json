      "html": "<button class=\"ds-btn-primary\">Add task</button>",
      "css": ".ds-btn-primary{min-height:44px;padding:0 16px;border-radius:6px;border:1px solid var(--acc);background:var(--btn-fill);color:var(--btn-ink);font-weight:600;font-family:var(--font-body)}.ds-btn-primary:hover{background:var(--btn-hover)}.ds-btn-primary:focus-visible{outline:2px solid var(--acc);outline-offset:2px}"
