      "description": "Quiet teal action.",
      "html": "<button class=\"ds-btn-ghost\">Move to tomorrow</button>",
      "css": ".ds-btn-ghost{min-height:44px;padding:0 12px;border-radius:6px;border:1px solid transparent;background:none;color:var(--acc);font-weight:600}.ds-btn-ghost:hover{background:var(--acc-soft)}.ds-btn-ghost:focus-visible{outline:2px solid var(--acc);outline-offset:2px}"
    },
    {
      "name": "Ruled Input",
      "kind": "input",
      "refersTo": "input-ruled",
      "description": "Written on a line, not typed into a box.",
      "html": "<input class=\"ds-ruled\" placeholder=\"One line on how the day looks\">",
      "css": ".ds-ruled{width:100%;min-height:44px;border:0;border-bottom:1px solid var(--rule-in);background:transparent;padding:8px 0;font-size:16px;color:var(--fg);caret-color:var(--acc)}.ds-ruled::placeholder{color:var(--mute)}.ds-ruled:focus{outline:none;border-bottom:2px solid var(--acc);padding-bottom:7px}"
    },
    {
      "name": "Ruled Row",
      "kind": "custom",
      "refersTo": "band-now",
      "description": "Band, time spine, title, side. The signature.",
      "html": "<div class=\"ds-row\"><span class=\"ds-band\">NOW</span><span class=\"ds-spine\">09:30</span><div><div class=\"ds-t1\">Send the invoice</div><div class=\"ds-t2\">Northwind</div></div></div>",
      "css": ".ds-row{display:grid;grid-template-columns:50px 60px 1fr;min-height:54px;border-bottom:1px solid var(--line2)}.ds-band{display:flex;justify-content:center;padding-top:19px;font:600 11px var(--font-mono);letter-spacing:.06em;color:var(--now);background:var(--now-soft);border-right:1px solid var(--line2)}.ds-spine{display:flex;align-items:center;justify-content:center;font:500 12.5px var(--font-mono);color:var(--fg2);border-right:1px solid var(--line)}.ds-t1{font-weight:500;padding:6px 4px 0}.ds-t2{font-size:13px;color:var(--fg2);padding:0 4px}"
    },
    {
      "name": "Section Heading",
      "kind": "custom",
      "refersTo": "sheet-paper",
      "description": "Uppercase heading over a 1 px ink rule.",
      "html": "<div class=\"ds-sec\"><h2>Today</h2><span>4</span></div>",
      "css": ".ds-sec{display:flex;justify-content:space-between;align-items:baseline;padding-bottom:6px;border-bottom:1px solid var(--fg)}.ds-sec h2{margin:0;font:600 13px var(--font-body);letter-spacing:.1em;text-transform:uppercase}.ds-sec span{font:12px var(--font-mono);color:var(--mute)}"
    },
